# Pinned versions of the measuring tools baked into the collector image that
# are not Python packages (lizard is pinned in pyproject.toml). Read by the
# Dockerfile (as build args, via .woodpecker/build.yml) and by
# scripts/check-image-tools.sh. Changing a version here changes measured
# values, so it is a measure version bump (AGENTS.md review criteria).
TOKEI_VERSION=15.0.0
